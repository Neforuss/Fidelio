{
  "manifest_version": 3,
  "name": "Fidelio – Hi-Res Element Screenshot",
  "version": "1.2.1",
  "description": "Screenshot any page element at 3× (or any) resolution, with an adjustable crop.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "debugger",
    "storage",
    "downloads",
    "contextMenus",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Pick an element to screenshot (high-res)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "start-picker": {
      "suggested_key": { "default": "Ctrl+Shift+Period", "mac": "Command+Shift+Period" },
      "description": "Pick an element to screenshot"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}
